{
  "name": "pi-supplyguard",
  "version": "0.1.0",
  "description": "Supply-chain policy enforcement for Pi coding agents",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "supply-chain-security",
    "coding-agent",
    "application-security"
  ],
  "files": [
    "src",
    "docs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
